# Public runtime URL used for metadata and local development.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Turso hosted libSQL. Keep both values server-only.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=replace-with-turso-auth-token

# Authentication boundary.
AUTH_SECRET=replace-with-a-high-entropy-secret

# Google OAuth refresh token encryption at rest key. Dedicated server-only key.
OAUTH_TOKEN_ENCRYPTION_KEY=replace-with-a-high-entropy-encryption-key

# Google AI Studio semantic onboarding classifier. Key stays server-only.
GOOGLE_AI_API_KEY=replace-with-google-ai-studio-api-key
GOOGLE_AI_MODEL=gemini-3.1-flash-lite
VERTEX_AI_PROJECT_ID=your-google-cloud-project-id
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_MODEL=replace-with-vertex-model-id
DAHL_INFERENCE_BASE_URL=https://api.example.invalid/v1
DAHL_INFERENCE_API_KEY=replace-with-dahl-api-key
DAHL_INFERENCE_MODEL=replace-with-fallback-model-id

# Google Workspace OAuth boundary.
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
GOOGLE_CLOUD_PROJECT_NUMBER=your-google-cloud-project-number
GOOGLE_PICKER_API_KEY=replace-with-google-picker-api-key

# Configurable execution and retention defaults for future server work.
AI_MAX_ITERATIONS=8
AI_TASK_TIMEOUT_MS=30000
AI_PROVIDER_TIMEOUT_MS=10000
AI_DAILY_COST_CEILING_MICROS=1000000
UNDO_WINDOW_MS=86400000
TASK_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=365
