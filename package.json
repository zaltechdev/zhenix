{
  "name": "aksa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=20.9.0",
    "bun": ">=1.3.14"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --emit-ts-declarations",
    "postinstall": "bun run i18n:compile",
    "predev": "bun run i18n:compile",
    "prebuild": "bun run i18n:compile",
    "prelint": "bun run i18n:compile",
    "pretypecheck": "bun run i18n:compile",
    "pretest": "bun run i18n:compile"
  },
  "dependencies": {
    "@icons-pack/react-simple-icons": "^13.13.0",
    "@libsql/client": "0.17.4",
    "@mediapipe/tasks-vision": "1.0.1",
    "@tiptap/core": "3.29.2",
    "@tiptap/pm": "3.29.2",
    "@tiptap/react": "3.29.2",
    "@tiptap/starter-kit": "3.29.2",
    "ai": "7.0.50",
    "country-flag-icons": "^1.6.20",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.28.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@inlang/paraglide-js": "2.23.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/jsdom": "28.0.3",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.0",
    "jsdom": "30.0.1",
    "postcss": "8.5.25",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
